# Copy this file to .env and replace both blank credentials with independent,
# randomly generated values before starting the service.
ERROR_TRACER_INGEST_KEY=
ERROR_TRACER_ADMIN_TOKEN=
# During a zero-downtime rotation, temporarily set the previous admin token.
ERROR_TRACER_ADMIN_TOKEN_PREVIOUS=

# One Error-Tracer process currently owns one project namespace.
ERROR_TRACER_PROJECT_ID=default

# Four connections enable WAL-backed concurrent reads. Use 1 for serialized
# access or in-memory databases.
ERROR_TRACER_SQLITE_MAX_OPEN_CONNECTIONS=4

# Retains the newest occurrences for each issue; lifetime aggregate counts are
# not reduced when older history rows are discarded.
ERROR_TRACER_MAX_EVENTS_PER_ISSUE=100

# Comma-separated exact browser origins. Keep blank for non-browser ingestion.
ERROR_TRACER_ALLOWED_ORIGINS=https://app.example.com

# Exposes low-cardinality Prometheus metrics at /metrics without authentication.
ERROR_TRACER_METRICS_ENABLED=false

ERROR_TRACER_PORT=8080
ERROR_TRACER_RATE_PER_MINUTE=120
ERROR_TRACER_RATE_BURST=30

# Deletes issues whose last occurrence is older than this many days.
# Zero disables automatic retention cleanup.
ERROR_TRACER_RETENTION_DAYS=0

# Enables a public, read-only dashboard backed only by built-in sample data.
# When enabled, open /?demo=1 to enter the demo without credentials.
ERROR_TRACER_DEMO_MODE=false
